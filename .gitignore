bin/
obj/
*.nupkg
nupkg/
*.user
.vs/
tests-output/
output/

# Local upstream clones, fork checkouts, and temporary source archives.
_archive/

# Third-party source is committed as plain source snapshots only.
# Do not add nested upstream repositories or submodule metadata.
**/.git/
.gitmodules

# Claude agent development files — keep development process private.
.claude/

# Temporary trash / staging area before permanent deletion.
delete/

# Captured build/log output accidentally saved into source dirs (e.g. Pdf/tools/*.txt).
# Tools projects hold only source (.cs/.csproj/.json); stray .txt there is build-log noise.
**/tools/*.txt
*_build.txt
